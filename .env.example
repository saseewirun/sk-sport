# ============================================================================
# SK-Sport — Environment variables template
# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development and fill in REAL values.
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# In production these values are set in the Vercel Dashboard
# (Project → Settings → Environment Variables), NOT in any committed file.
# ============================================================================

NODE_OPTIONS=--no-deprecation --no-experimental-strip-types

# ── Payload ─────────────────────────────────────────────────────────────────
# Generate a fresh secret: openssl rand -hex 16
PAYLOAD_SECRET=<your-payload-secret>

# ── Supabase Postgres ───────────────────────────────────────────────────────
# Use the CURRENT/active Supabase project. The pooled (port 6543) connection
# string is found in Supabase Dashboard → Project Settings → Database.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# ── Supabase Storage (S3-compatible) ────────────────────────────────────────
# MUST belong to the SAME Supabase project as DATABASE_URI, otherwise media
# uploaded through the CMS will not load on the site.
# S3 access keys: Supabase Dashboard → Project Settings → Storage → S3 access keys.
S3_BUCKET=payload-media
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
S3_REGION=<region>
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=SK Sport Trading

# ── Public ──────────────────────────────────────────────────────────────────
# Used by Payload to build absolute URLs (order links, payment slips, emails).
NEXT_PUBLIC_SERVER_URL=https://sksporttrading.com

# NOTE: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY
# are no longer required — the unused @supabase/supabase-js client was removed.
# Supabase is reached only as Payload's Postgres (DATABASE_URI) + S3 storage.

# ============================================================================
# One-off migration scripts (migrate-db.mjs / migrate-s3.mjs) ONLY.
# Put these in a separate, git-ignored `migrate.env` and load with:
#   node --env-file=migrate.env migrate-db.mjs
# ----------------------------------------------------------------------------
OLD_DATABASE_URI=postgresql://postgres.<old-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
NEW_DATABASE_URI=postgresql://postgres.<new-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

OLD_S3_ENDPOINT=https://<old-ref>.storage.supabase.co/storage/v1/s3
OLD_S3_REGION=<region>
OLD_S3_ACCESS_KEY_ID=<old-s3-access-key-id>
OLD_S3_SECRET_ACCESS_KEY=<old-s3-secret-access-key>

NEW_S3_ENDPOINT=https://<new-ref>.storage.supabase.co/storage/v1/s3
NEW_S3_REGION=<region>
NEW_S3_ACCESS_KEY_ID=<new-s3-access-key-id>
NEW_S3_SECRET_ACCESS_KEY=<new-s3-secret-access-key>

S3_BUCKET=payload-media
