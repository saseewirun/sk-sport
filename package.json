{
  "name": "sksport",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "admin:dev": "node scripts/admin-dev-server.mjs",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier . --write",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint --max-warnings=0",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix --max-warnings=0",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" npx playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@payloadcms/db-postgres": "3.77.0",
    "@payloadcms/email-resend": "3.77.0",
    "@payloadcms/next": "3.77.0",
    "@payloadcms/richtext-lexical": "3.77.0",
    "@payloadcms/storage-s3": "3.77.0",
    "@payloadcms/ui": "3.77.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.8",
    "@supabase/supabase-js": "^2.36.0",
    "@tailwindcss/postcss": "^4.1.18",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "^12.34.0",
    "graphql": "^16.8.1",
    "husky": "^9.1.7",
    "next": "^15.5.12",
    "next-intl": "^4.8.0",
    "payload": "3.77.0",
    "postcss": "^8.5.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "daisyui": "^5.5.14",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
