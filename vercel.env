# ────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — DO NOT PUT REAL SECRETS IN THIS FILE.
#
# This file documents the environment variables that must be configured in the
# Vercel Dashboard (Project → Settings → Environment Variables) for Production.
# Real secret values live ONLY in Vercel, never in git.
#
# See .env.example for the full list and docs/DEPLOYMENT-MIGRATION.md for the
# step-by-step Supabase migration / cut-over checklist.
# ────────────────────────────────────────────────────────────────────────────

NODE_OPTIONS=--no-deprecation --no-experimental-strip-types

# Payload — generate with: openssl rand -hex 16
PAYLOAD_SECRET=<your-payload-secret>

# Supabase Postgres (use the CURRENT/active project, not the decommissioned one)
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage (S3-compatible) — must be the SAME project as DATABASE_URI
S3_BUCKET=payload-media
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
S3_REGION=<region>
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3

# Email (Resend)
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=SK Sport Trading

# Public
NEXT_PUBLIC_SERVER_URL=https://sk-sport.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://<public-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<supabase-publishable-key>
